#include <Arduino.h>
#include <Wire.h>
#include "Adafruit_SHT31.h"

// Create two SHT31 sensors
Adafruit_SHT31 sht31_1 = Adafruit_SHT31();
Adafruit_SHT31 sht31_2 = Adafruit_SHT31();

void setup() {

  Serial.begin(9600);
  Wire.begin();

  while (!Serial)
    delay(10);

  Serial.println("Two SHT31 Sensor Test");

  // Start Sensor 1 at address 0x44
  if (!sht31_1.begin(0x44)) {
    Serial.println("Couldn't find SHT31 #1 at 0x44");
    while (1)
      delay(1);
  }

  // Start Sensor 2 at address 0x45
  if (!sht31_2.begin(0x45)) {
    Serial.println("Couldn't find SHT31 #2 at 0x45");
    while (1)
      delay(1);
  }

  Serial.println("Both sensors found!");
}

void loop() {

  // Read Sensor 1
  float t1 = sht31_1.readTemperature();
  float h1 = sht31_1.readHumidity();

  // Read Sensor 2
  float t2 = sht31_2.readTemperature();
  float h2 = sht31_2.readHumidity();

  // Sensor 1

  Serial.println("Sensor 1:");

  if (!isnan(t1)) {
    Serial.print("Temperature: ");
    Serial.print(t1);
    Serial.println(" C");
  }
  else {
    Serial.println("Temperature Error");
  }

  if (!isnan(h1)) {
    Serial.print("Humidity: ");
    Serial.print(h1);
    Serial.println(" %");
  }
  else {
    Serial.println("Humidity Error");
  }

  // Sensor 2
  
  Serial.println("Sensor 2:");

  if (!isnan(t2)) {
    Serial.print("Temperature: ");
    Serial.print(t2);
    Serial.println(" C");
  }
  else {
    Serial.println("Temperature Error");
  }

  if (!isnan(h2)) {
    Serial.print("Humidity: ");
    Serial.print(h2);
    Serial.println(" %");
  }
  else {
    Serial.println("Humidity Error");
  }

  Serial.println("--------------------");

  delay(1000);
}
