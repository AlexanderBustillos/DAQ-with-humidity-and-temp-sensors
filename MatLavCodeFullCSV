%% SHT31 + Mass Balance Serial Reader
close all;
clear;
clc;

%% Serial

% COM4 = Mass balance
% COM5 = Room temperature/humidity sensor
% COM6 = Inside chamber temperature/humidity sensor

port4 = "/COM4";
port5 = "/COM5";
port6 = "/COM6";

baudRate = 9600;

% Test number
% Change this for each new experiment
testNumber = 1;

% Folder where CSV files will be saved
directory_samples = '\Users\PV\Desktop\samples';


%% CSV file

% One CSV file 
dataFile = fullfile(directory_samples, ...
    sprintf('Test%d.csv', testNumber));

% Check if file already exists
if exist(dataFile, 'file')
    warning("Data file already exists: %s", dataFile);
end


%% Serial connections

disp("Connecting to serial devices...");

MB4 = serialport(port4, baudRate);
arduino5 = serialport(port5, baudRate);
arduino6 = serialport(port6, baudRate);

% Clear any old data
flush(MB4);
flush(arduino5);
flush(arduino6);

% Give Arduinos/sensors time to start
pause(2);

% Clear any startup data
flush(MB4);
flush(arduino5);
flush(arduino6);

disp("Serial connections established.");


%% Data table

% One table
dataTable = table('Size', [0 6], ...
    'VariableTypes', ...
    {'double','double','double','double','double','double'}, ...
    'VariableNames', ...
    {'Time_s','Mass_g', ...
     'Temp5_C','Humidity5_percent', ...
     'Temp6_C','Humidity6_percent'});


%% Figures

fig = figure('Name', 'SHT31 + Mass Balance Data', ...
             'NumberTitle', 'off');


% Mass
axMass = subplot(5,1,1);

massPlot4 = plot(axMass, NaN, NaN, '-o', ...
    'MarkerSize', 4);

grid(axMass, 'on');

xlabel(axMass, "Time (s)");
ylabel(axMass, "Mass (g)");
title(axMass, "Mass Balance");


% Temp sensor 5
axTemp5 = subplot(5,1,2);

tempPlot5 = plot(axTemp5, NaN, NaN, '-o', ...
    'MarkerSize', 4);

grid(axTemp5, 'on');

xlabel(axTemp5, "Time (s)");
ylabel(axTemp5, "Temperature (°C)");
title(axTemp5, "SHT31 Temperature - COM5");


% Humidity sensor 5
axHumidity5 = subplot(5,1,3);

humidityPlot5 = plot(axHumidity5, NaN, NaN, '-o', ...
    'MarkerSize', 4);

grid(axHumidity5, 'on');

xlabel(axHumidity5, "Time (s)");
ylabel(axHumidity5, "Humidity (%)");
title(axHumidity5, "SHT31 Humidity - COM5");


% Temp sensor 6
axTemp6 = subplot(5,1,4);

tempPlot6 = plot(axTemp6, NaN, NaN, '-o', ...
    'MarkerSize', 4);

grid(axTemp6, 'on');

xlabel(axTemp6, "Time (s)");
ylabel(axTemp6, "Temperature (°C)");
title(axTemp6, "SHT31 Temperature - COM6");


% Humidity sensor 6
axHumidity6 = subplot(5,1,5);

humidityPlot6 = plot(axHumidity6, NaN, NaN, '-o', ...
    'MarkerSize', 4);

grid(axHumidity6, 'on');

xlabel(axHumidity6, "Time (s)");
ylabel(axHumidity6, "Humidity (%)");
title(axHumidity6, "SHT31 Humidity - COM6");


%% Data tips

dcm = datacursormode(fig);

dcm.Enable = 'on';
dcm.SnapToDataVertex = 'on';
dcm.UpdateFcn = @dataTipText;


%% Data arrays

timeData = [];

MassData4 = [];

tempData5 = [];
humidityData5 = [];

tempData6 = [];
humidityData6 = [];


%% Timer

startTime = datetime("now");


%% Last measurements

% These hold the most recent valid measurement
% from each sensor.

Mass4 = NaN;

temperature5 = NaN;
humidity5 = NaN;

temperature6 = NaN;
humidity6 = NaN;


%% Reading timer

% Used to save one row every 1 second
lastReadingTime = -1;


%% Main loop

while isvalid(fig)

    %% Mass balance

    if MB4.NumBytesAvailable > 0

        try

            % Read one complete line from COM4
            data4 = readline(MB4);

            % Display exactly what the mass balance sent
            disp("Mass balance: " + data4);

            % Find the number in the line
            numberString = regexp(data4, ...
                '[-+]?\s*\d+\.\d+', 'match', 'once');

            if ~isempty(numberString)

                % Remove spaces
                numberString = strrep(numberString, ' ', '');

                % Convert string to number
                Mass4 = str2double(numberString);

            end

        catch ME

            warning("Could not read mass balance: %s", ...
                ME.message);

        end

    end


    %% Sensor 5

    if arduino5.NumBytesAvailable > 0

        try

            data5 = readline(arduino5);

            values5 = sscanf(data5, "%f,%f");

            if length(values5) >= 2

                temperature5 = values5(1);
                humidity5 = values5(2);

            end

        catch

            warning("Could not read COM5.");

        end

    end


    %% Sensor 6

    if arduino6.NumBytesAvailable > 0

        try

            data6 = readline(arduino6);

            values6 = sscanf(data6, "%f,%f");

            if length(values6) >= 2

                temperature6 = values6(1);
                humidity6 = values6(2);

            end

        catch

            warning("Could not read COM6.");

        end

    end


    %% Time

    elapsedTime = seconds( ...
        datetime("now") - startTime);


    %% Store data

    % Only store a measurement once all three devices
    % have provided at least one valid measurement.

    if ~isnan(Mass4) && ...
       ~isnan(temperature5) && ...
       ~isnan(humidity5) && ...
       ~isnan(temperature6) && ...
       ~isnan(humidity6)

        % Only save one reading every 1 second
        if elapsedTime - lastReadingTime >= 1

            lastReadingTime = elapsedTime;


            %% Store data in arrays

            timeData(end+1) = elapsedTime;

            MassData4(end+1) = Mass4;

            tempData5(end+1) = temperature5;
            humidityData5(end+1) = humidity5;

            tempData6(end+1) = temperature6;
            humidityData6(end+1) = humidity6;


            %% Update plots

            set(massPlot4, ...
                'XData', timeData, ...
                'YData', MassData4);

            set(tempPlot5, ...
                'XData', timeData, ...
                'YData', tempData5);

            set(humidityPlot5, ...
                'XData', timeData, ...
                'YData', humidityData5);

            set(tempPlot6, ...
                'XData', timeData, ...
                'YData', tempData6);

            set(humidityPlot6, ...
                'XData', timeData, ...
                'YData', humidityData6);


            %% Create one new row

            newRow = table( ...
                elapsedTime, ...
                Mass4, ...
                temperature5, ...
                humidity5, ...
                temperature6, ...
                humidity6, ...
                'VariableNames', ...
                {'Time_s','Mass_g', ...
                 'Temp5_C','Humidity5_percent', ...
                 'Temp6_C','Humidity6_percent'});


            %% Add row to main table

            dataTable = [dataTable; newRow];


            %% Save to CSV file

            writetable(dataTable, dataFile);

            % Display the row being saved
            disp("Saved data:");
            disp(newRow);

        end

    end


    %% Figure

    drawnow limitrate;

    % Small pause so MATLAB does not run the loop unnecessarily fast
    pause(0.01);

end


%% Final CSV update

% Make sure final data is saved
writetable(dataTable, dataFile);



%% Clear serial connections

clear MB4 arduino5 arduino6;


%% Data tip function

function txt = dataTipText(~, event)

    % Get point location
    pos = event.Position;

    t = pos(1);
    v = pos(2);

    % Find which axis the point belongs to
    ax = ancestor(event.Target, 'axes');

    % Get axis title
    axTitle = ax.Title.String;

    % Determine what type of data is being displayed

    if contains(axTitle, "Mass")

        txt = { ...
            sprintf('Time: %.2f s', t), ...
            sprintf('Mass: %.4f g', v) ...
            };

    elseif contains(axTitle, "Temperature")

        txt = { ...
            sprintf('Time: %.2f s', t), ...
            sprintf('Temperature: %.2f °C', v) ...
            };

    elseif contains(axTitle, "Humidity")

        txt = { ...
            sprintf('Time: %.2f s', t), ...
            sprintf('Humidity: %.2f %%', v) ...
            };

    else

        txt = { ...
            sprintf('Time: %.2f s', t), ...
            sprintf('Value: %.2f', v) ...
            };

    end

end
