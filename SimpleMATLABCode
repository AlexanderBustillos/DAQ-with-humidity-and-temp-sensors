%% Mass Balance Serial Reader
close all;
clear;
clc;

%% Serial

% COM4 = Mass balance

port4 = "/COM4";

baudRate = 9600;

% Test number
% Change this for each new experiment
testNumber = 1;

% Folder where CSV files will be saved
directory_samples = '/Users/alex/Desktop/samples/';



%% Serial connecction

disp("Connecting to mass balance...");

MB4 = serialport(port4, baudRate);

% Clear any old data
flush(MB4);

% Give mass balance time to start
pause(2);

% Clear any startup data
flush(MB4);

disp("Serial connection established.");


%% CSV file name

massFile = fullfile(directory_samples, ...
    sprintf('Mass%d.csv', testNumber));

% Check if file already exists
if exist(massFile, 'file')
    warning("Mass file already exists: %s", massFile);
end


%% Data table

massTable = table('Size', [0 2], ...
    'VariableTypes', {'double','double'}, ...
    'VariableNames', ...
    {'Time_s','Mass_g'});


%% Figure

fig = figure('Name', 'Mass Balance Data', ...
             'NumberTitle', 'off');

massPlot4 = plot(NaN, NaN, '-o', ...
    'MarkerSize', 4);

grid on;

xlabel("Time (s)");
ylabel("Mass (g)");
title("Mass Balance");


%% Data tips

dcm = datacursormode(fig);

dcm.Enable = 'on';
dcm.SnapToDataVertex = 'on';
dcm.UpdateFcn = @dataTipText;


%% Buffers

timeData = [];

MassData4 = [];


%% Timmer

startTime = datetime("now");


%% Main loop

while isvalid(fig)

    %% Mass balance

if MB4.NumBytesAvailable > 0

    try

        % Read all available lines
        while MB4.NumBytesAvailable > 0

            data4 = readline(MB4);

            % Example input:
            % +   0.005 g +
            %    0.005 g +
            %    0.005 g

            % Extract the number from the line
            values4 = sscanf(data4, "%f");

            if ~isempty(values4)

                Mass4 = values4(1);

                %% Time

                elapsedTime = seconds( ...
                    datetime("now") - startTime);


                %% Store data

                timeData(end+1) = elapsedTime;

                MassData4(end+1) = Mass4;


                %% Plot

                set(massPlot4, ...
                    'XData', timeData, ...
                    'YData', MassData4);


                %% Save mass data

                newMassRow = table( ...
                    elapsedTime, ...
                    Mass4, ...
                    'VariableNames', ...
                    {'Time_s','Mass_g'});

                massTable = [massTable; newMassRow];


                %% CSV update

                writetable(massTable, massFile);

            end

        end

    catch

        warning("Could not read mass balance.");

    end

end


    %% Figure

    drawnow limitrate;

    % Small pause
    pause(0.01);

end


%% Final CSV update

writetable(massTable, massFile);

% Clear serial connection
clear MB4;


%% Data function

function txt = dataTipText(~, event)

    % Get point location
    pos = event.Position;

    t = pos(1);
    v = pos(2);

    txt = { ...
        sprintf('Time: %.2f s', t), ...
        sprintf('Mass: %.3f g', v) ...
        };

end
